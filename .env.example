# Copy to .env. Secrets stay server-side; nothing here reaches the browser bundle.
DATABASE_URL=postgres://fs:fs@localhost:5432/fs
API_PUBLIC_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Claude (server only). Without a key the assistant returns AGENT_UNAVAILABLE,
# unless AGENT_OFFLINE=true (deterministic scripted assistant for demos/tests).
# ANTHROPIC_API_KEY=
AGENT_OFFLINE=false
AGENT_MODEL=claude-opus-5-5
AGENT_SMALL_MODEL=claude-haiku-5-5
AGENT_DAILY_TOKEN_BUDGET=2000000

IFC_SERVICE_URL=http://localhost:8000

# S3-compatible storage (MinIO from docker compose). Unset S3_ENDPOINT to use local files.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=feasibility
S3_ACCESS_KEY=fsminio
S3_SECRET_KEY=fsminio-secret

# Draft rule sets (incl. the TEST fixture) are usable in development only.
ALLOW_DRAFT_RULESETS=true

# Frontend basemap style (MapTiler, Stadia or self-hosted). Unset = OSM tiles, dev only.
# VITE_BASEMAP_STYLE=https://api.maptiler.com/maps/streets-v2/style.json?key=...
